% ==================================================================
% 简历文档类 (resume.cls)
% 用途: 中文简历模板自定义类，基于 article 类
% ==================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{resume}[2025/08/21 Cleaned resume class for zh_CN]

% ------------------------------------------------------------------
% 基础类设置
% ------------------------------------------------------------------
\LoadClass[11pt]{article}  % 基于 article 类，11pt 字号

% 取消段落首行缩进（简历通常不需要缩进）
\setlength{\parindent}{0pt}

% ------------------------------------------------------------------
% 宏包加载
% ------------------------------------------------------------------
\RequirePackage{xltxtra}      % XeLaTeX 扩展功能
\RequirePackage{fontspec}     % 字体设置支持
\RequirePackage{hyperref}     % 超链接支持
\RequirePackage{url}          % URL 支持
\RequirePackage{fontawesome}  % 图标支持
\RequirePackage{geometry}     % 页面布局设置
\RequirePackage{titlesec}     % 标题格式设置
\RequirePackage{enumitem}     % 列表格式设置

% ------------------------------------------------------------------
% 页面尺寸设置 (geometry)
% ------------------------------------------------------------------
\geometry{
  a4paper,         % A4 纸张
  left=0.8in,      % 左边距 0.8 英寸
  right=0.8in,     % 右边距 0.8 英寸
  top=0.40in,      % 上边距 0.40 英寸
  bottom=0.1in,    % 下边距 0.1 英寸
  nohead           % 无页眉
}

% ==================================================================
% Section 样式配置
% ==================================================================
% 格式: \titleformat{命令}{格式}{标签}{间距}{前代码}[后代码]
\titleformat{\section}
  {\Large\scshape\raggedright}  % 格式: 大号字体 + 小型大写 + 左对齐
  {}{0em}{}                      % 无编号标签，无间距
  [\titlerule]                   % 标题后添加横线分隔

% 间距设置: \titlespacing*{命令}{左缩进}{段前}{段后}
\titlespacing*{\section}{0cm}{*1.5}{*1.5}  % 无缩进，段前段后各1.5倍行距

% ==================================================================
% 列表样式配置
% ==================================================================
% noitemsep: 去除列表项之间的额外间距
% topsep: 列表整体与上下文的间距
% leftmargin: 左缩进距离 (pc = pica, 1pc ≈ 12pt)
\setlist[itemize]{noitemsep, topsep=0.25em, leftmargin=1.5pc}
\setlist[enumerate]{noitemsep, topsep=0.25em, leftmargin=1.5pc}

% ==================================================================
% 自定义命令定义
% ==================================================================

% ------------------------------------------------------------------
% \name{姓名}
% 用途: 在页面顶部居中显示姓名
% 参数: #1 - 姓名文本
% ------------------------------------------------------------------
\newcommand{\name}[1]{%
  \centerline{\Huge\scshape{#1}}%  居中 + 超大号 + 小型大写字母
  \vspace{1.5ex}%                   姓名下方1.5ex间距
}

% ------------------------------------------------------------------
% \contactInfo{邮箱}{电话}{主页}
% 用途: 三列表格显示联系方式（左-邮箱 | 中-电话 | 右-主页）
% 参数: #1-邮箱地址, #2-电话号码, #3-个人主页URL
% ------------------------------------------------------------------
\newcommand{\contactInfo}[3]{%
  \vspace{0.5em}%                   联系方式上方间距
  \noindent                         % 取消段落缩进
  \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} l c r}
    % 左列: 邮箱图标 + 邮件链接（等宽字体）
    \faEnvelope\ \href{mailto:#1}{\large\texttt{#1}} &
    % 中列: 电话图标 + 电话号码
    \faPhone\ \large #2 &
    % 右列: 链接图标 + 主页URL
    \faLink\ \href{#3}{\large #3} \\
  \end{tabular*}
}

% ------------------------------------------------------------------
% \triplerow{单位/项目}{职位/角色}{时间}
% 用途: 三列布局展示经历（工作/实习/项目）
% 参数: #1-单位或项目名称（粗体）, #2-职位或角色（斜体）, #3-时间段
% ------------------------------------------------------------------
\newcommand{\triplerow}[3]{%
  \vspace{0.5ex}%                   条目前方0.5ex间距
  \noindent                         % 取消段落缩进
  \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} l c r}
    {\large\bfseries #1} & \textit{#2} & #3 \\
  \end{tabular*}%
  \vspace{0.8ex}%                   条目下方0.8ex间距
}

% ------------------------------------------------------------------
% \triplerowschool{学校}{专业}{时间}
% 用途: 三列布局展示教育背景
% 参数: #1-学校名称（粗体）, #2-专业（斜体）, #3-毕业时间
% ------------------------------------------------------------------
\newcommand{\triplerowschool}[3]{%
  \noindent                         % 取消段落缩进
  \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} l c r}
    \textbf{#1} & \textit{#2} & #3 \\
  \end{tabular*}
}

% ------------------------------------------------------------------
% \award{奖项}{描述}{时间}
% 用途: 单行显示获奖情况，时间右对齐
% 参数: #1-奖项名称（斜体）, #2-补充描述, #3-获奖时间
% ------------------------------------------------------------------
\newcommand{\award}[3]{%
  {\par \textit{#1}，#2 \hfill #3 \par}%
  % \hfill: 弹性空格，将时间推向右侧
}

% ------------------------------------------------------------------
% \photowidth
% 用途: 照片宽度（可通过 \renewcommand 覆盖）
% ------------------------------------------------------------------
\newcommand{\photowidth}{3cm}

% ------------------------------------------------------------------
% \makeheader{照片文件}{姓名}{邮箱}{电话}{主页}
% 用途: 带照片的页眉，照片居左、姓名+联系方式居右
% 参数: #1-照片文件, #2-姓名, #3-邮箱, #4-电话, #5-主页
% ------------------------------------------------------------------
\newcommand{\makeheader}[5]{%
  \noindent
  \begin{minipage}[c]{\photowidth}
    \includegraphics[width=\photowidth]{#1}%
  \end{minipage}%
  \hfill
  \begin{minipage}[c]{\dimexpr\textwidth-\photowidth-1em\relax}
    \name{#2}%
    \contactInfo{#3}{#4}{#5}%
  \end{minipage}%
}